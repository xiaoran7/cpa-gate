# ==============================================================================
# CPA-Gate 环境变量配置示例模板
# ==============================================================================

# 1. 核心安全凭据 (必填，生产环境必须使用强随机字符串，长度 >= 24 位)
# ------------------------------------------------------------------------------
# Gate 网关管理密钥（用于登录 /admin 控制台及调用网关管理 API）
GATE_ADMIN_SECRET=your-random-gate-admin-secret-at-least-24-chars-long

# 上游 CLIProxyAPI (CPA) 远程管理明文密钥（必须与 CPA 启动配置中的明文 secret-key 保持一致）
GATE_MGMT_SECRET=your-random-cpa-mgmt-secret-at-least-24-chars-long


# 2. 上游 CPA 连接配置 (选填)
# ------------------------------------------------------------------------------
# 上游 CPA 服务主机与端口（默认仅在宿主机 127.0.0.1 环回通信）
GATE_UPSTREAM_HOST=127.0.0.1
GATE_UPSTREAM_PORT=8315

# CPA 管理面接口主机与端口（通常与 UPSTREAM 一致）
GATE_MGMT_HOST=127.0.0.1
GATE_MGMT_PORT=8315


# 3. 存储与数据持久化 (选填)
# ------------------------------------------------------------------------------
# 数据主工作目录（默认为 ./data）
GATE_DIR=./data

# SQLite 数据库文件路径（默认为 ${GATE_DIR}/gate.db）
GATE_DB=./data/gate.db


# 4. 监听端口与网络绑定 (选填)
# ------------------------------------------------------------------------------
# 监听目标分号列表，格式：host:port:name
# 默认开启 8316 (Nginx/OpenResty 反代入口) 和 8317 (直连入口)
GATE_BIND_TARGETS=127.0.0.1:8316:Reverse Proxy Port;127.0.0.1:8317:Local Direct Port


# 5. 请求限制与熔断防护 (选填)
# ------------------------------------------------------------------------------
# 客户端推理请求体最大字节限制（默认 64 MiB）
GATE_MAX_REQUEST_BODY_BYTES=67108864

# 管理端请求体最大字节限制（默认 256 KiB）
GATE_MAX_ADMIN_BODY_BYTES=262144

# Prometheus /metrics 访问鉴权 Token（留空则免密）
GATE_METRICS_TOKEN=

# 连续失败熔断阈值（默认连续 5 次 5xx 触发短效退避熔断）
GATE_UPSTREAM_FAILURE_THRESHOLD=5

# 熔断冷却恢复时间 (毫秒，默认 15000ms 即 15s)
GATE_UPSTREAM_COOLDOWN_MS=15000


# 6. 告警推送与监控集成 (选填)
# ------------------------------------------------------------------------------
# 异常告警 Webhook（支持多个，英文逗号分隔）
GATE_NOTIFY_WEBHOOKS=

# Uptime Kuma 监控心跳 Push URL（可选，每 60 秒自动打点）
GATE_UPTIME_KUMA_PUSH_URL=
